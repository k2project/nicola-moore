# Build-time variables. On Cloudflare set them under
# Workers & Pages → nicola-moore-app → Settings → Build → Variables and secrets.
# See _documentation/seo-and-search-console.md.

# GA4 measurement ID (G-XXXXXXXXXX). Analytics is off when empty.
NEXT_PUBLIC_GA_ID=
# Google Search Console "HTML tag" token. Production only.
GOOGLE_SITE_VERIFICATION=
